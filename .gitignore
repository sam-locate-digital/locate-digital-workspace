# Secrets & credentials
.env
.env.*
.env-secrets/
!.env.example

# Explicit secret files
*password*
*passwords*
*credentials*
*credential*
*secret*
*secrets*
!*secret*.example
!*secrets*.example

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# Google / OAuth token files
client_secret*.json
service_account*.json
token.json
token*.json
oauth_token*

# API key exports
*api_key*
*api-key*
*apikey*

# Claude local settings (may contain API keys)
settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Office temp files
~$*

# Google Docs shortcuts (local references only, not content)
*.gdoc
*.gsheet
*.gslides

# Skills: the Claude app manages _skills/synced itself; never commit caches
_skills/synced/
__pycache__/
*.pyc
.coverage

# Client website repos: each is its own private GitHub repo (site-<client>), cloned here.
# See _ops/website-launch.md. Never commit them into the workspace or push them as a subtree.
clients/*/website/
_brand/Website Demo/demos/harlow-cms-test/

# Workspace housekeeping folders (see CLAUDE.md)
_inbox/
_to-delete/
.claude/worktrees/

# Large media: Google Drive keeps it, git doesn't need it
_brand/Content/Raw Footage/
_brand/Content/Exports/
_brand/Content/References/
_brand/Content/_DROP FILES HERE/
_brand/Tutorials/Raw Footage/
_brand/Tutorials/Exports/
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.heic
*.HEIC
*.psd
*.zip
node_modules/

# Raw image renders before the logo/text pass (the finished slides sit one level up)
clients/*/Social Media Post/*/raw/

# Full-size AI photo originals in demo folders (the sites use the WebP/JPG copies in images/)
_brand/Website Demo/demos/*/*.png
_brand/Website Demo/demo-mortgage broker/*.png
